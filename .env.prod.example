# compose.prod.yaml이 읽는 값. 이 파일을 복사해서 .env.prod를 만들고 값을 채운다 (.env.prod는 git에 올리지 않는다)
#   cp .env.prod.example .env.prod
# 비밀번호는 개발용(.env)과 다른 값으로 새로 만든다.
# 영어와 숫자만 쓴다 (@, :, / 같은 특수문자는 DATABASE_URL 주소 안에서 다른 뜻이 된다)

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=my_notes
# 앱(api) 전용 계정
MYSQL_USER=my_notes_app
MYSQL_PASSWORD=change-me-app

# 주소. 내 컴퓨터에서 시험할 때는 아래 값, 배포하면 https://chagoknotes.com, https://api.chagoknotes.com
WEB_URL=http://localhost:3001
API_URL=http://localhost:4001
# 로그인 쿠키를 web과 api가 함께 쓸 도메인. 내 컴퓨터에서는 비워 두고, 배포하면 chagoknotes.com
COOKIE_DOMAIN=

# Google 로그인 (apps/api/.env와 같은 값)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 처음 가입할 때 이미지 업로드 권한을 켤 이메일. 여러 개면 쉼표로 구분
ADMIN_EMAILS=
