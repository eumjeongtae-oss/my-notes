# 자동 배포 작업 하나 (auto-deploy.sh를 한 번 실행하고 끝난다).
# 언제 실행할지는 my-notes-deploy.timer가 정한다. 설치 방법은 deploy/README.md
[Unit]
Description=my-notes 자동 배포 (새 이미지가 있으면 받아서 다시 켜기)
After=docker.service network-online.target
Wants=network-online.target

[Service]
# oneshot: 끝까지 실행하고 끝나는 작업. 앞 실행이 안 끝났으면 다음 실행을 시작하지 않는다 (겹치지 않음)
Type=oneshot
User=ubuntu
ExecStart=/home/ubuntu/my-notes/deploy/auto-deploy.sh
