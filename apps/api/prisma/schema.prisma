// DB 설계도. 모델을 바꾼 뒤 `pnpm prisma migrate dev --name 변경내용`으로 DB에 반영한다.
// 코드에서는 camelCase(createdAt), DB에서는 snake_case(created_at)로 쓴다 (@map, @@map).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// 시리즈: 여러 노트를 순서대로 묶는 단위 (velog 시리즈)
model Series {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  // DB 칸이 아니라 "이 시리즈에 속한 노트들"을 꺼내 쓰기 위한 관계 설명
  notes     Note[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("series")
}

model Note {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  // MySQL에서 String의 기본 타입은 VARCHAR(191)이라 긴 본문이 들어가지 않는다.
  // MediumText는 최대 약 16MB
  content     String   @db.MediumText
  // 실제 DB 칸(외래 키). 시리즈에 속하지 않으면 null
  seriesId    Int?     @map("series_id")
  // DB 칸이 아니라 seriesId가 Series.id를 가리킨다는 관계 설명.
  // 시리즈가 삭제되면 노트는 남기고 seriesId만 비운다(SetNull)
  series      Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  // 시리즈 안에서 몇 번째 글인지
  seriesOrder Int?     @map("series_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // 홈 맨 위에 고정할 노트인지. 기존 노트는 모두 고정 안 된 상태(false)로 시작한다
  pinned      Boolean  @default(false)

  // 인덱스(책 뒤의 찾아보기): 홈 목록 정렬/무한스크롤(작성 시각순), 시리즈 안의 순서 조회용
  @@index([createdAt, id])
  @@index([seriesId, seriesOrder])
  @@map("notes")
}

// 사용자. Google로 처음 로그인할 때 만들어진다 (누구나 가입).
model User {
  id              Int       @id @default(autoincrement())
  // Google 계정의 고유 번호(sub). 이메일은 바뀔 수 있지만 이 값은 바뀌지 않아서, 사용자를 찾을 때는 이걸 쓴다
  googleId        String    @unique @map("google_id") @db.VarChar(255)
  email           String    @db.VarChar(255)
  name            String    @db.VarChar(100)
  // Google 프로필 사진 주소. 없을 수도 있다
  picture         String?   @db.VarChar(1000)
  // 이미지 업로드(S3) 권한. 비용이 드는 기능이라 기본은 꺼짐.
  // ADMIN_EMAILS의 이메일로 처음 가입하면 켜고, 다른 사람은 DB에서 직접 켠다
  canUploadImages Boolean   @default(false) @map("can_upload_images")
  sessions        Session[]
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

// 로그인 세션: "이 쿠키를 가진 브라우저는 이 사용자로 로그인했다"는 기록.
// 로그인하면 한 줄 생기고, 로그아웃하거나 기한이 지나면 지운다.
model Session {
  // 쿠키에 넣는 토큰(무작위 문자열)을 SHA-256으로 바꾼 값(64글자).
  // 토큰 원본은 브라우저 쿠키에만 있고, DB에는 바꾼 값만 둔다.
  // DB가 유출돼도 이 값으로는 쿠키를 만들 수 없다 (비밀번호를 그대로 저장하지 않는 것과 같은 이유)
  id        String   @id @db.Char(64)
  userId    Int      @map("user_id")
  // 사용자가 지워지면 그 사람의 세션도 같이 지운다(Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 이 시각이 지나면 로그인이 풀린다
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}
