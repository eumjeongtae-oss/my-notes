# 이 파일을 복사해서 .env를 만들고 값을 채운다. (.env는 git에 올리지 않는다)
#   cp .env.example .env

# 백엔드가 접속할 DB 주소 (형식: mysql://사용자:비밀번호@호스트:포트/DB이름)
# 비밀번호는 루트 .env의 MYSQL_ROOT_PASSWORD와 같은 값을 넣는다
DATABASE_URL="mysql://root:change-me@localhost:3306/my_notes"

# CORS: 브라우저에서 이 API를 부를 수 있게 허락할 출처(프론트 주소). 여러 개면 쉼표로 구분
CORS_ORIGINS=http://localhost:3000

# Google 로그인 (Google Cloud Console → Google 인증 플랫폼 → 클라이언트에서 발급)
# 클라이언트 보안 비밀번호(SECRET)는 비밀 값이다. 절대 git이나 프론트에 넣지 않는다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google이 로그인 후 돌려보낼 주소. Console의 "승인된 리디렉션 URI"와 글자 하나까지 같아야 한다
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# 로그인을 허락할 Google 이메일. 여러 개면 쉼표로 구분
ALLOWED_EMAILS=
