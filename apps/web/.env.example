# 이 파일을 복사해서 .env를 만든다. (.env는 git에 올리지 않는다)
#   cp .env.example .env

# 백엔드(apps/api) 주소. 서버 컴포넌트가 API를 호출할 때 쓴다.
# 배포하면 실제 백엔드 주소로 바꾼다.
API_URL=http://localhost:4000

# 백엔드 주소 (브라우저용). 저장 버튼처럼 브라우저가 직접 API를 부를 때 쓴다.
# NEXT_PUBLIC_으로 시작해야 브라우저 코드에 들어간다. 누구나 볼 수 있으니 비밀 값은 넣지 않는다.
NEXT_PUBLIC_API_URL=http://localhost:4000
