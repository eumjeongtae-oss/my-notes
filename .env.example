# 이 파일을 복사해서 .env를 만들고 값을 채운다. (.env는 git에 올리지 않는다)
#   cp .env.example .env

# 로컬 Docker MySQL (compose.yaml에서 사용)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=my_notes

# Prisma가 접속할 DB 주소 (형식: mysql://사용자:비밀번호@호스트:포트/DB이름)
# 비밀번호는 위 MYSQL_ROOT_PASSWORD와 같은 값을 넣는다
DATABASE_URL="mysql://root:change-me@localhost:3306/my_notes"
